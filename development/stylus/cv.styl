.loading
  position fixed
  top 0
  bottom 0
  right 0
  left 0
  background-color #FFF
  background-position 50% 50%
  background-repeat no-repeat
  background-image url('../svg/clock.svg')
  background-size 40px
  z-index 32000
  opacity 1
  transition opacity .25s
  &.loaded
    pointer-events none
    opacity 0

html.no-svg .loading
  background-image url('../svg/clock.png')


body>header
  padding 5.236rem 3.236rem 0
  max-width 50rem
  margin auto
  position relative
  white-space nowrap
  h1
    font-size 4.8rem
    display inline-block
  .headline
    font-size 1.618rem
    margin .809rem 0 0
    white-space normal
  .contact-line
    margin .809rem 0 0
    white-space normal
    color #666
    & + .contact-line
      margin-top .4045rem
  .sep
    margin 0 .25em
  .qr
    display none
  .contact-line
    a,
    span:not(.sep)
      white-space nowrap
    &.languages span+span
      margin-left .3em

html[lang^="ru"]
  .pdf a[lang^="en"],
  .language a[lang^="ru"]
    display none

html[lang^="en"]
  .pdf a[lang^="ru"],
  .language a[lang^="en"]
    display none

.pdf
  position absolute
  top 1.5rem
  left 0
  right 0
  text-align center
  a
    font-size .85rem
    display inline-block
    border 1px solid #e8e8e8
    padding .25rem .5rem
    border-radius 3px
    text-decoration none
    text-transform uppercase
    &:hover
      background-color #e8e8e8


.language
  display inline-block
  vertical-align middle
  position relative

  a
    position absolute
    bottom -1.5rem
    left 1rem
    text-decoration none
    white-space nowrap
    font-size .85rem
    display block
    width 6rem
    height 6rem
    line-height 6rem
    border-radius 100%
    text-align center
    background-color #e8e8e8
    &:hover
      background-color darken(#e8e8e8, 10%)
      &:after
        border-color darken(#e8e8e8, 10%) transparent transparent
    &:after
      content ""
      display block
      height 0
      width 0
      position absolute
      top 100%
      left 50%
      margin -.1rem 0 0 -.4rem
      line-height 0
      overflow hidden
      border-style solid
      border-color #e8e8e8 transparent transparent
      border-width .85rem .4rem 0
      transform-origin 50% -2.9rem
      transform rotate(50deg)


section
  max-width 50rem
  margin 3.236rem auto 6.472rem
  padding 0 3.236rem

  header
    box-sizing border-box
    vertical-align middle

  .wrapper
    margin auto
    box-sizing border-box
    line-height 1.618rem

  table
    width 100%
    font-size 1rem
    th,
    td
      box-sizing border-box
      padding 0.809rem 1.618rem
      border-bottom 1px solid #e8e8e8
      &:first-child
        width 10rem
        padding-left 0
    td
      p
        margin 0
      p+p
        margin 1.618rem 0 0
    th
      text-transform uppercase
      padding-bottom 3.236rem
    tr:last-child td
      border-bottom-style none

  &.examples

    font-size 0
    line-height 0
    &:after
      clear both
      content ""
      display block
      height 0
      line-height 0
      font-size 0
      overflow hidden

    .slides
      article
        float left
        width 50%
        box-sizing border-box
        padding 0 0 1px 1px
      figure
        text-align center
        width 100%
        height 350px
        border 1px solid #e8e8e8
        line-height 350px
        overflow hidden
        display inline-block
        vertical-align top
        position relative
        box-sizing border-box
        display table
        vertical-align middle
        object,
        img
          width 100%
          min-width 100%
          min-height 100%
          vertical-align middle
          display inline-block
          position absolute
          left 0
          top 0
          bottom 0
          right 0
          z-index 1
        &:hover
          figcaption
            opacity 1
            transform scale(1)
            box-shadow 0 0 0 400px rgba(0,0,0,.1)
        .open
          display block
          width 3rem
          height 3rem
          position absolute
          left 1px
          bottom 1px
          line-height 3rem
          text-align center
          background-color #FFF
          color #000
          z-index 3
          .open:after
            content "+"
            font-size 24px
        figcaption
          vertical-align middle
          white-space nowrap
          overflow hidden
          text-overflow ellipsis
          transition transform .25s, opacity .25s
          background-color rgba(255,255,255,1)
          padding 0.5rem
          text-align left
          font-size 0.85rem
          line-height 1.618rem
          position relative
          display inline-block
          z-index 2
          transform scale(.8)
          opacity 0

  &.talks,
  &.publications
    table
      td:first-child
        width 33%
        padding-left 0
        h2
          color #333
          margin 0
          font-size 1.618rem
          line-height 2rem
      td
        font-size .85rem
        color #666
        padding .4045rem 1.618rem
        p
          font-size .85rem
        h2
          color #333
          line-height 2rem
          margin 0
          font-size 1.4rem

  &.person
    .summary
      margin 1.618rem 0 0
      p
        margin 0
      p+p
        margin 1rem 0 0


  &.education
    .education-list
      list-style none
      padding 0
      margin 0
      .education-item
        list-style none
        margin-block 1.618rem
        padding-block 0 1.618rem
        border-bottom 1px solid #e8e8e8
        &:last-child
          border-bottom none
          margin-bottom 0
        .edu-date
          color #666
          font-size 1rem
          white-space nowrap
          margin-inline-end 1rem
          time
            display inline
        .edu-content
          display inline
          font-weight bold
          font-size 1rem
          line-height 1.618rem
          margin 0
        .grades
          list-style-position: inside;
          margin-block 0.809rem 0
          margin-inline 0
          padding 0

  &.experience
    .experience-list
      list-style none
      padding 0
      margin 0
      .experience-item
        list-style none
        margin-block 1.618rem
        padding-block 0 1.618rem
        border-bottom 1px solid #e8e8e8
        &:last-child
          border-bottom none
          margin-bottom 0
        .exp-date
          color #666
          font-size 1rem
          white-space nowrap
          margin-inline-end 1rem
          time
            display inline
        h3.position
          display inline
          font-weight bold
          font-size 1rem
          line-height 1.618rem
          margin 0
        .skills
          color #666
          font-size 1rem
          display inline-block
          margin-block-start 0.809rem
        section[data-l10n-id^="experience_"]
          margin-block 0.809rem 0
          margin-inline 0
          padding 0
          p
            margin 0
            break-inside avoid
          p+p
            margin-top 1.618rem

  &.skills
    table
      tbody+thead th
        border-top 1px solid #e8e8e8
        padding-top 1.618rem
      th,
      td
        width 33.333%
        border-bottom-style none
        border-right 1px solid #e8e8e8
        padding 0.4045rem 1.618rem
        &.inprogress
          color #ccc
      th:first-child,
      td:first-child
        width 33.333%
        padding-left 0
      th
        font-size 1rem
        padding 0.4045rem 1.618rem 1.618rem
        color #666
      th:last-child,
      td:last-child
        border-right-style none
      tr:last-child td
        padding-bottom 1.618rem
    .skills-list
      list-style none
      padding 0
      margin 1.618rem 0 0
      li
        margin 0 0 0.809rem
        line-height 1.618rem
        .label
          font-weight normal
          font-variant small-caps
          font-variant-caps small-caps
          text-transform lowercase
          color #000
          font-size 1rem
          letter-spacing 0.05em
        span:not(.label)
          font-size 1rem
          color #000



@media (max-width: 55rem)
  body>header h1
    font-size 4rem
    white-space normal

@media (max-width: 45rem)
  body>header h1
    font-size 3rem
    white-space normal
  section.skills
    table
      thead
        th
          font-size 0.85rem
          padding-bottom 0.4045rem
      th,td
        padding 0
        border-right-style none


@media (max-width: 37rem)
  body>header h1
    font-size 2rem
    white-space normal
  html,
  html body
    font-size 14px

@media (max-width: 25rem)
  body>header h1
    font-size 1.7rem
    white-space normal
  html,
  html body
    font-size 12px

@media print and (color)
  *
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;

@media print
  nav.language,
  nav.pdf
    display none

  img
    max-height 100%

  html,
  html body
    font-size 12px !important
    color #000
    background #fff

  a
    text-decoration none

  section
    max-width none
    margin-top 1.618rem
    margin-bottom 3.236rem
    page-break-inside auto
    tr,
    td,
    th
      page-break-inside avoid
    header
      page-break-after avoid

  // Keep only the four most recent jobs on paper. The class is repeated to
  // outweigh the specificity of the rule that sets the border.
  .experience-item:nth-child(n+5)
    display none
  .experience-item.experience-item.experience-item.experience-item.experience-item.experience-item:nth-child(4)
    border-bottom none

  // Keep only the six most recent talks on paper. Talks given in Ukrainian
  // are dropped from the English version, so it has to skip one row further.
  html:not([lang^="en"]) .talksTable
    tr:nth-child(n+7)
      display none
    tr:nth-child(6) td
      border-bottom-style none

  html[lang^="en"] .talksTable
    tr[data-lang="ua"],
    tr:nth-child(n+8)
      display none
    tr:nth-child(7) td
      border-bottom-style none


  a[href^=htt]:after
    content " <" attr(href) "> "

  a.link-inside[href^=htt]:after
    display none

  body>header
    max-width none
    padding-top 0
    padding-right unquote('calc(3.236rem + 155px + 1.618rem)')

    h1
      padding 0
      font-size 3rem

    .qr
      display block
      position absolute
      top 0
      right 3.236rem
      width 155px
      height 155px


  img
    page-break-inside avoid

  @page
    size A4
    margin 1cm
